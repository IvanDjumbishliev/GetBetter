{
  "name": "getbetter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate && npm run build -w server && npm run build -w client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "dotenv -e server/.env -- prisma migrate dev",
    "db:deploy": "dotenv -e server/.env -- prisma migrate deploy",
    "db:studio": "dotenv -e server/.env -- prisma studio",
    "db:seed": "dotenv -e server/.env -- prisma db seed",
    "db:reset": "dotenv -e server/.env -- prisma migrate reset",
    "test": "npm run test -w server",
    "user:set-role": "dotenv -e server/.env -- tsx server/scripts/set-role.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
