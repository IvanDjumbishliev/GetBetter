{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src",
    "test",
    "tsup.config.ts",
    "vitest.config.ts",
    "../shared/src",
    "../prisma/**/*.ts"
  ]
}
